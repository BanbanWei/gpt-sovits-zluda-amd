+def seq_max_len(lengths: torch.Tensor) -> int:
+    """Maximum of a 1-D length tensor, computed on the CPU.
+
+    ZLUDA: CUDA reductions over these tiny length tensors return wrong values
+    (observed 119 for a true maximum of 134), which silently builds masks and
+    length slices of the wrong width and aborts training.  These tensors hold
+    only a handful of elements, so reducing on the CPU is exact and free.
+    """
+    if lengths.is_cuda:
+        return int(lengths.detach().to("cpu").max())
+    return int(lengths.max())
